{
  "name": "luluax-term",
  "version": "1.0.0",
  "description": "Modern SSH & Terminal Client with Cloud Sync for Windows and macOS Apple Silicon",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "dev:mac": "bash dev-mac.sh",
    "build:mac": "bash build-mac.sh",
    "dev:win": "dev-win.bat",
    "build:win": "build-win.bat",
    "build:mac-arm64": "electron-builder --mac --arm64",
    "build:win-exe": "electron-builder --win portable"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "node-pty": "^1.1.0",
    "ssh2": "^1.17.0",
    "uuid": "^14.0.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.luluax.term",
    "productName": "LuluaX-Term",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable",
        "dir"
      ]
    },
    "asarUnpack": [
      "**/node-pty/**"
    ]
  }
}
